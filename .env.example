# HyphyLiquid — Environment variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# Hyperliquid wallet
# Start with TESTNET — no real money until risk.py and the canary are validated.
# Get test USDC from: https://app.hyperliquid-testnet.xyz/drip
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_ENV=testnet

# Optional: a separate address to receive fills/journaling (not required for v1)
# HYPERLIQUID_RPC_URL=

# Risk overrides (optional — config/settings.yaml is the source of truth)
HYPERLIQUID_BANKROLL=1000
HYPERLIQUID_MAX_LEVERAGE=10
HYPERLIQUID_MAX_RISK_PCT=0.01
HYPERLIQUID_DAILY_LOSS_LIMIT_PCT=0.03

# Notifications (optional, for trade alerts)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
